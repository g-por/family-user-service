# Copy to application-prod.yml locally and adjust as needed (do not commit the real file)
spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://postgres:5432/familybudget}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:postgres}
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
  h2:
    console:
      enabled: false

app:
  security:
    allow-dev-endpoints: false

management:
  endpoints:
    web:
      exposure:
        include: health
  endpoint:
    health:
      probes:
        enabled: true

server:
  port: 8081
