# Copy this file to application-local.yml and fill in real values.
# Keep application-local.yml out of Git (ignored by root .gitignore).

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/familybudget
    username: postgres
    password: "REPLACE_ME"
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        jdbc:
          time_zone: UTC

# JWT Configuration (read real secret from env if possible)
jwt:
  secret: "REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS"
  issuer: family-budget
  access-token-ttl-min: 30
  refresh-token-ttl-days: 30

server:
  port: 8081

spring:
  flyway:
    enabled: false
